JIRA_BASE_URL=https://jira.example.com
JIRA_AUTH_MODE=basic
JIRA_USERNAME=your.username
JIRA_PASSWORD=your-password
# JIRA_TOKEN=

JIRA_STRICT_SSL=true
# JIRA_CA_CERT_PATH=/absolute/path/to/internal-ca.pem
JIRA_TIMEOUT_MS=30000
JIRA_MAX_RESULTS=50
JIRA_MAX_RESPONSE_BYTES=1048576

JIRA_ENABLE_WRITE_TOOLS=false
JIRA_ENABLE_DESTRUCTIVE_TOOLS=false
JIRA_READ_ONLY=true
JIRA_DRY_RUN=false
JIRA_AUDIT_LOG=false
JIRA_LOG_LEVEL=info

# Comma-separated project keys
# JIRA_ALLOWED_PROJECTS=ABC,PLATFORM
# JIRA_DENIED_PROJECTS=SECRET
# JIRA_DEFAULT_PROJECT=ABC

# Optional enterprise header mode
# JIRA_AUTH_HEADER_NAME=X-Forwarded-User
# JIRA_AUTH_HEADER_VALUE=service-account

# Optional bearer mode. PATs are not available on Jira 7.7.1 and were introduced later.
# JIRA_TOKEN=your-bearer-token

# Optional local auth proxy. Run with: jira-legacy-auth-proxy
# Point the MCP server at JIRA_BASE_URL=http://127.0.0.1:4877 and use header auth
# with JIRA_AUTH_HEADER_NAME=x-jira-proxy-token when JIRA_PROXY_LOCAL_TOKEN is set.
# JIRA_PROXY_UPSTREAM_BASE_URL=https://jira.example.com
# JIRA_PROXY_AUTH_MODE=basic
# JIRA_PROXY_USERNAME=your.username
# JIRA_PROXY_PASSWORD=your-password
# JIRA_PROXY_TOKEN=
# JIRA_PROXY_HOST=127.0.0.1
# JIRA_PROXY_PORT=4877
# JIRA_PROXY_LOCAL_TOKEN=local-shared-secret
# JIRA_PROXY_ENABLE_WRITE=false
# JIRA_PROXY_ENABLE_AGILE_API=false
# JIRA_PROXY_STRICT_SSL=true
# JIRA_PROXY_CA_CERT_PATH=/absolute/path/to/internal-ca.pem
# JIRA_PROXY_LOG_LEVEL=info
