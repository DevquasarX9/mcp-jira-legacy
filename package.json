{
  "name": "jira-legacy-mcp-cli",
  "version": "0.2.2",
  "description": "MCP server for legacy Jira Server and Jira Data Center using REST API v2",
  "type": "module",
  "bin": {
    "jira-legacy-mcp-cli": "./dist/index.js",
    "jira-legacy-auth-proxy": "./dist/proxy/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/index.ts",
    "dev:proxy": "tsx watch src/proxy/index.ts",
    "lint": "npm run typecheck",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "start:proxy": "node dist/proxy/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "jira",
    "jira-server",
    "jira-server-7",
    "jira-data-center",
    "self-hosted-jira",
    "jira-rest-api",
    "jira-rest-api-v2",
    "atlassian",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "codex",
    "stdio",
    "typescript"
  ],
  "author": "Ivelin Ivanov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevquasarX9/mcp-jira-legacy.git"
  },
  "bugs": {
    "url": "https://github.com/DevquasarX9/mcp-jira-legacy/issues"
  },
  "homepage": "https://github.com/DevquasarX9/mcp-jira-legacy#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
