{
  "name": "@devquasarx9/jira-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for legacy Jira Server and Jira Data Center using REST API v2",
  "type": "module",
  "bin": {
    "jira-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/index.ts",
    "lint": "npm run typecheck",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "jira",
    "jira-server",
    "jira-server-7",
    "jira-data-center",
    "self-hosted-jira",
    "jira-rest-api",
    "jira-rest-api-v2",
    "atlassian",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "codex",
    "stdio",
    "typescript"
  ],
  "author": "Ivelin Ivanov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevquasarX9/mcp-jira-legacy.git"
  },
  "bugs": {
    "url": "https://github.com/DevquasarX9/mcp-jira-legacy/issues"
  },
  "homepage": "https://github.com/DevquasarX9/mcp-jira-legacy#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "npm@11.5.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "undici": "^7.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
